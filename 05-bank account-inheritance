# ==================================================
# 1. BASE CLASS (Parent Class)
# ==================================================
class CanadianBankAccount:
    def __init__(self, account_holder, balance=0.0):
        self.account_holder = account_holder
        self.balance = float(balance)
        self.currency = "CAD"

    def deposit(self, amount):
        if amount > 0:
            self.balance += amount
            return f"Deposited ${amount:.2f} {self.currency}. New balance: ${self.balance:.2f} {self.currency}"
        return "Error: Invalid deposit amount."

    def withdraw(self, amount):
        if 0 < amount <= self.balance:
            self.balance -= amount
            return f"Withdrew ${amount:.2f} {self.currency}. New balance: ${self.balance:.2f} {self.currency}"
        return "Error: Insufficient funds or invalid amount."

    def get_info(self):
        return f"Account Holder: {self.account_holder}, Balance: ${self.balance:.2f} {self.currency}"


# ==================================================
# 2. SINGLE INHERITANCE (Canadian High-Interest Savings Account)
# ==================================================
class CanadianSavingsAccount(CanadianBankAccount):
    def __init__(self, account_holder, balance=0.0, annual_interest_rate=0.04):
        super().__init__(account_holder, balance)
        self.annual_interest_rate = annual_interest_rate  # Typical HISA rate

    def calculate_monthly_interest(self):
        """Calculates approximate monthly interest earned based on the annual rate."""
        monthly_interest = (self.balance * self.annual_interest_rate) / 12
        self.balance += monthly_interest
        return f"Monthly interest added: ${monthly_interest:.2f} CAD. New balance: ${self.balance:.2f} CAD"


# ==================================================
# 3. SINGLE INHERITANCE (Canadian Chequing Account with Overdraft Protection)
# ==================================================
class CanadianChequingAccount(CanadianBankAccount):
    def __init__(self, account_holder, balance=0.0, overdraft_limit=500.0):
        super().__init__(account_holder, balance)
        self.overdraft_limit = overdraft_limit  # Standard overdraft protection feature

    def withdraw(self, amount):
        if amount <= 0:
            return "Error: Invalid withdrawal amount."
        
        # Checking if funds + overdraft limit cover the transaction
        if amount <= (self.balance + self.overdraft_limit):
            self.balance -= amount
            return f"Successfully withdrew ${amount:.2f} CAD (Overdraft utilized if needed). New balance: ${self.balance:.2f} CAD"
        else:
            return "Error: Transaction declined. Exceeds available balance and overdraft limit."


# ==================================================
# TESTING THE TORONTO BANKING SYSTEM
# ==================================================
if __name__ == "__main__":
    print("--- Toronto High-Interest Savings Account Test ---")
    toronto_savings = CanadianSavingsAccount("Sara Nazari", 5000.0, annual_interest_rate=0.045)
    print(toronto_savings.get_info())
    print(toronto_savings.calculate_monthly_interest())

    print("\n--- Toronto Daily Chequing Account Test ---")
    toronto_chequing = CanadianChequingAccount("Sara Nazari", 150.0, overdraft_limit=500.0)
    print(toronto_chequing.get_info())
    # Withdrawing more than current balance ($150), but within the $500 overdraft limit
    print(toronto_chequing.withdraw(300.0))
